{
  "name": "usp-butanta-bus-monitor",
  "version": "1.0.0",
  "description": "Sistema de monitoramento em tempo real dos ônibus da USP Butantã com integração à API SPTrans",
  "main": "public/index.html",
  "scripts": {
    "dev:static": "live-server public/",
    "dev:api": "vercel dev",
    "dev:all": "npm-run-all --parallel dev:static dev:api"
  },
  "keywords": [
    "usp",
    "butanta",
    "bus",
    "sptrans",
    "real-time",
    "pwa",
    "transport",
    "sao-paulo"
  ],
  "author": "Bruno Gehlen <brunogfdsilva@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/username/usp-butanta-bus-monitor"
  },
  "homepage": "https://monitorusp.vercel.app",
  "dependencies": {
    "node-fetch": "^2.6.7"
  },
  "devDependencies": {
    "@vercel/node": "^3.0.0",
    "npm-run-all": "^4.1.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "vercel": {
    "functions": {
      "api/sptrans.js": {
        "maxDuration": 30
      }
    }
  }
}
