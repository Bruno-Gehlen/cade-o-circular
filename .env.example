# Token da API Olho Vivo da SPTrans
# Obtenha em: https://www.sptrans.com.br/desenvolvedores/
# Copie este arquivo para ".env" e substitua pelo seu token real.
# (O arquivo .env já está no .gitignore — nunca commite o token.)
SPTRANS_API_KEY=coloque_seu_token_aqui

# Porta do servidor (opcional, padrão: 3000)
# PORT=3000
