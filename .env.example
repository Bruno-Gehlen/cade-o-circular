# Token da API Olho Vivo da SPTrans (usado APENAS pelo worker)
# Obtenha em: https://www.sptrans.com.br/desenvolvedores/
SPTRANS_API_KEY=coloque_seu_token_aqui

# URL pública ou interna do worker (usado pelo web service)
# Exemplo local: http://localhost:4000
# Exemplo Render: https://cade-o-circular-worker.onrender.com
WORKER_URL=http://localhost:4000

# Chave secreta compartilhada entre web service e worker
# Gere um valor aleatório longo (ex.: openssl rand -hex 32)
WORKER_API_KEY=chave_aleatoria_longa_aqui

# Porta do servidor (opcional, padrão: 3000 para web, 4000 para worker)
# PORT=3000
